<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.multitools.tools.converter.UnitConverterController"
            stylesheets="@../style.css"
    styleClass="root">

    <!-- ==================== HEADER ==================== -->

    <top>
        <HBox alignment="CENTER_LEFT"
                spacing="12"
                prefHeight="82"
                style="-fx-background-color: #f5f7f9;
                        -fx-border-color: #cbd5df;
                        -fx-border-width: 0 0 1 0;
                        -fx-padding: 0 20 0 20;">

                <Button text="← Retour"
                        onAction="#handleBack"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #64748b;
                               -fx-font-size: 14px;
                               -fx-cursor: hand;
                               -fx-padding: 8 12 8 12;"/>

                <Region prefWidth="10"/>

                <Label text="🔄"
       style="-fx-font-family: 'Segoe UI Emoji';
              -fx-font-size: 20px;"/>

                <VBox spacing="2">
                        <Label text="Convertisseur"
                        style="-fx-font-size: 20px;
                                -fx-font-weight: bold;
                                -fx-text-fill: #111827;"/>

                        <Label text="Conversion d'unités"
                        style="-fx-font-size: 14px;
                                -fx-text-fill: #64748b;"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <VBox alignment="CENTER_RIGHT"
                        spacing="2">
                        <Button text="↻  Mises à jour"
                                onAction="#handleUpdateCheck"
                                style="-fx-background-color: transparent;
                                -fx-text-fill: #111827;
                                -fx-font-size: 14px;
                                -fx-cursor: hand;"/>

                        <Label fx:id="versionLabel"
                        text="Version 1.0.0"
                        style="-fx-text-fill: #64748b;
                                -fx-font-size: 11px;"/>
                </VBox>

                </HBox>
    </top>


    <!-- ==================== CONTENU ==================== -->

    <center>
        <VBox spacing="20"
              style="-fx-padding: 30 40 40 40;">

            <!-- Sélection de catégorie -->
            <VBox spacing="8">
                <Label text="Catégorie"
                       style="-fx-font-size: 14px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #52677d;"/>
                <ComboBox fx:id="categoryComboBox"
                          prefWidth="400"
                          prefHeight="47"
                          style="-fx-background-color: white;
                                 -fx-border-color: #b9c6d3;
                                 -fx-border-radius: 8;
                                 -fx-background-radius: 8;
                                 -fx-font-size: 16px;"/>
            </VBox>

            <!-- Unités -->
            <HBox spacing="20" alignment="CENTER_LEFT">
                <VBox spacing="8" HBox.hgrow="ALWAYS">
                    <Label text="De"
                           style="-fx-font-size: 14px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #52677d;"/>
                    <ComboBox fx:id="fromUnitComboBox"
                              prefWidth="200"
                              prefHeight="47"
                              style="-fx-background-color: white;
                                     -fx-border-color: #b9c6d3;
                                     -fx-border-radius: 8;
                                     -fx-background-radius: 8;
                                     -fx-font-size: 16px;"/>
                </VBox>

                <Button text="⇄"
                        onAction="#swapUnits"
                        prefHeight="47"
                        prefWidth="47"
                        style="-fx-background-color: #087edb;
                               -fx-text-fill: white;
                               -fx-font-size: 20px;
                               -fx-background-radius: 8;
                               -fx-cursor: hand;"/>

                <VBox spacing="8" HBox.hgrow="ALWAYS">
                    <Label text="Vers"
                           style="-fx-font-size: 14px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #52677d;"/>
                    <ComboBox fx:id="toUnitComboBox"
                              prefWidth="200"
                              prefHeight="47"
                              style="-fx-background-color: white;
                                     -fx-border-color: #b9c6d3;
                                     -fx-border-radius: 8;
                                     -fx-background-radius: 8;
                                     -fx-font-size: 16px;"/>
                </VBox>
            </HBox>

            <!-- Valeurs -->
            <HBox spacing="20" alignment="CENTER_LEFT">
                <VBox spacing="8" HBox.hgrow="ALWAYS">
                    <Label text="Valeur"
                           style="-fx-font-size: 14px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #52677d;"/>
                    <TextField fx:id="inputValue"
                               promptText="Entrez une valeur"
                               prefHeight="47"
                               style="-fx-background-color: white;
                                      -fx-border-color: #b9c6d3;
                                      -fx-border-radius: 8;
                                      -fx-background-radius: 8;
                                      -fx-font-size: 16px;"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <VBox spacing="8" HBox.hgrow="ALWAYS">
                    <Label text="Résultat"
                           style="-fx-font-size: 14px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #52677d;"/>
                    <TextField fx:id="outputValue"
                               editable="false"
                               prefHeight="47"
                               style="-fx-background-color: #edf3f8;
                                      -fx-border-color: #b9c6d3;
                                      -fx-border-radius: 8;
                                      -fx-background-radius: 8;
                                      -fx-font-size: 16px;"/>
                </VBox>
            </HBox>

            <!-- Résultat détaillé -->
            <VBox spacing="10"
                  style="-fx-background-color: #edf3f8;
                         -fx-border-color: #cbd5df;
                         -fx-border-radius: 10;
                         -fx-background-radius: 10;
                         -fx-padding: 20;">
                <Label fx:id="resultLabel"
                       text="Entrez une valeur pour voir le résultat"
                       style="-fx-font-size: 16px;
                              -fx-text-fill: #334155;
                              -fx-font-weight: bold;
                              -fx-wrap-text: true;"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

        </VBox>
    </center>


    <!-- ==================== FOOTER ==================== -->

    <bottom>
        <HBox alignment="CENTER_LEFT"
              spacing="10"
              prefHeight="80"
              style="-fx-background-color: #f5f7f9;
                     -fx-border-color: #cbd5df;
                     -fx-border-width: 1 0 0 0;
                     -fx-padding: 10 20 10 20;">

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="Effacer"
                    onAction="#clearFields"
                    prefHeight="50"
                    prefWidth="150"
                    style="-fx-background-color: white;
                           -fx-text-fill: #1e293b;
                           -fx-border-color: #b9c6d3;
                           -fx-border-radius: 9;
                           -fx-background-radius: 9;
                           -fx-font-size: 16px;
                           -fx-cursor: hand;"/>

            <Button text="Aide"
                    onAction="#showHelp"
                    prefHeight="50"
                    prefWidth="150"
                    style="-fx-background-color: #64748b;
                           -fx-text-fill: white;
                           -fx-background-radius: 9;
                           -fx-font-size: 16px;
                           -fx-cursor: hand;"/>

        </HBox>
    </bottom>

</BorderPane>
