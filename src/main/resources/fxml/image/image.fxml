<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import com.example.multitools.ui.BackButton?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.multitools.tools.image.ImageController"
            stylesheets="@../style.css"
            styleClass="root">
    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="12"
              prefHeight="82"
              style="-fx-background-color: #f5f7f9;
                     -fx-border-color: #cbd5df;
                     -fx-border-width: 0 0 1 0;
                     -fx-padding: 0 20 0 20;">
            <BackButton onAction="#handleBack"/>
            <Region prefWidth="10"/>
            <Label text="🖼️"
                   style="-fx-font-family: 'Segoe UI Emoji';
                          -fx-font-size: 20px;"/>
            <VBox spacing="2">
                <Label text="Image"
                       style="-fx-font-size: 20px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #111827;"/>
                <Label text="Conversion et outils d'image"
                       style="-fx-font-size: 14px;
                              -fx-text-fill: #64748b;"/>
            </VBox>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    fitToHeight="true"
                    style="-fx-background-color: #f8fafc;
                           -fx-border-color: transparent;">
            <VBox spacing="30"
                  style="-fx-padding: 30 40 40 40;">
                <FlowPane hgap="20"
                          vgap="20"
                          alignment="TOP_CENTER">
                    <VBox spacing="12"
                          prefWidth="280"
                          prefHeight="180"
                          styleClass="tool-card"
                          style="-fx-padding: 24;"
                          onMouseClicked="#openImageConverter">
                        <HBox alignment="CENTER_LEFT" spacing="16">
                            <Label text="PNG · JPG · WebP · ICO"
                                   style="-fx-font-size: 18px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #087edb;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                        </HBox>
                        <VBox spacing="4">
                            <Label text="Convertisseur d'image"
                                   style="-fx-font-size: 18px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #1e293b;
                                          -fx-font-family: 'Segoe UI', sans-serif;"/>
                            <Label text="Choisir un format : WebP, PNG, JPG ou ICO"
                                   wrapText="true"
                                   style="-fx-font-size: 13px;
                                          -fx-text-fill: #64748b;
                                          -fx-font-family: 'Segoe UI', sans-serif;"/>
                        </VBox>
                    </VBox>

                    <VBox spacing="12"
                          prefWidth="280"
                          prefHeight="180"
                          styleClass="tool-card"
                          style="-fx-padding: 24;"
                          onMouseClicked="#openImageCrop">
                        <HBox alignment="CENTER_LEFT" spacing="16">
                            <Label text="↔"
                                   style="-fx-font-size: 32px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #087edb;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                        </HBox>
                        <VBox spacing="4">
                            <Label text="Recadrer une image"
                                   style="-fx-font-size: 18px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #1e293b;
                                          -fx-font-family: 'Segoe UI', sans-serif;"/>
                            <Label text="Sélectionner à la souris la zone à conserver"
                                   wrapText="true"
                                   style="-fx-font-size: 13px;
                                          -fx-text-fill: #64748b;
                                          -fx-font-family: 'Segoe UI', sans-serif;"/>
                        </VBox>
                    </VBox>

                    <VBox spacing="12"
                          prefWidth="280"
                          prefHeight="180"
                          styleClass="tool-card"
                          style="-fx-padding: 24;"
                          onMouseClicked="#openBackgroundRemoval">
                        <HBox alignment="CENTER_LEFT" spacing="16">
                            <Label text="◐"
                                   style="-fx-font-size: 32px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #087edb;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                        </HBox>
                        <VBox spacing="4">
                            <Label text="Retirer le fond blanc"
                                   style="-fx-font-size: 18px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #1e293b;
                                          -fx-font-family: 'Segoe UI', sans-serif;"/>
                            <Label text="Rendre le fond blanc transparent et enregistrer en PNG"
                                   wrapText="true"
                                   style="-fx-font-size: 13px;
                                          -fx-text-fill: #64748b;
                                          -fx-font-family: 'Segoe UI', sans-serif;"/>
                        </VBox>
                    </VBox>

                    <VBox spacing="12"
                          prefWidth="280"
                          prefHeight="180"
                          styleClass="tool-card"
                          style="-fx-padding: 24;"
                          onMouseClicked="#openColorExtraction">
                        <HBox alignment="CENTER_LEFT" spacing="16">
                            <Label text="🎨"
                                   style="-fx-font-size: 30px;
                                          -fx-font-family: 'Segoe UI Emoji';"/>
                            <Region HBox.hgrow="ALWAYS"/>
                        </HBox>
                        <VBox spacing="4">
                            <Label text="Extraire les couleurs"
                                   style="-fx-font-size: 18px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #1e293b;
                                          -fx-font-family: 'Segoe UI', sans-serif;"/>
                            <Label text="Créer une palette et copier les codes HEX ou RVB"
                                   wrapText="true"
                                   style="-fx-font-size: 13px;
                                          -fx-text-fill: #64748b;
                                          -fx-font-family: 'Segoe UI', sans-serif;"/>
                        </VBox>
                    </VBox>
                </FlowPane>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
