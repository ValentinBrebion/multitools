<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.multitools.tools.security.PasswordGeneratorController"
            stylesheets="@../style.css"
    styleClass="root">

    <!-- ==================== HEADER ==================== -->

    <top>
        <HBox alignment="CENTER_LEFT"
                spacing="12"
                prefHeight="82"
                style="-fx-background-color: #f5f7f9;
                        -fx-border-color: #cbd5df;
                        -fx-border-width: 0 0 1 0;
                        -fx-padding: 0 20 0 20;">

                <Button text="← Retour"
                        onAction="#handleBack"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #64748b;
                               -fx-font-size: 14px;
                               -fx-cursor: hand;
                               -fx-padding: 8 12 8 12;"/>

                <Region prefWidth="10"/>

                <Label text="🔑"
       style="-fx-font-family: 'Segoe UI Emoji';
              -fx-font-size: 20px;"/>

                <VBox spacing="2">
                        <Label text="Générateur de mot de passe"
                        style="-fx-font-size: 20px;
                                -fx-font-weight: bold;
                                -fx-text-fill: #111827;"/>

                        <Label text="Créez des mots de passe sécurisés"
                        style="-fx-font-size: 14px;
                                -fx-text-fill: #64748b;"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <VBox alignment="CENTER_RIGHT"
                        spacing="2">
                        <Button text="↻  Mises à jour"
                                onAction="#handleUpdateCheck"
                                style="-fx-background-color: transparent;
                                -fx-text-fill: #111827;
                                -fx-font-size: 14px;
                                -fx-cursor: hand;"/>

                        <Label fx:id="versionLabel"
                        text="Version 1.0.0"
                        style="-fx-text-fill: #64748b;
                               -fx-font-size: 11px;"/>
                </VBox>

                </HBox>
    </top>


    <!-- ==================== CONTENU ==================== -->

    <center>
        <VBox spacing="20"
              style="-fx-padding: 20;">

            <!-- Zone d'affichage du mot de passe -->
            <VBox spacing="10"
                  style="-fx-background-color: #f8fafc;
                         -fx-border-color: #cbd5df;
                         -fx-border-radius: 10;
                         -fx-background-radius: 10;
                         -fx-padding: 20;">

                <Label text="Mot de passe généré"
                       style="-fx-font-size: 14px;
                              -fx-text-fill: #52677d;"/>

                <HBox spacing="10">
                    <TextField fx:id="passwordField"
                              prefHeight="50"
                              HBox.hgrow="ALWAYS"
                              style="-fx-background-color: white;
                                     -fx-border-color: #b9c6d3;
                                     -fx-border-radius: 8;
                                     -fx-background-radius: 8;
                                     -fx-font-size: 18px;
                                     -fx-font-family: 'Consolas', monospace;"/>

                    <Button text="📋"
                            onAction="#copyPassword"
                            prefWidth="60"
                            prefHeight="50"
                            style="-fx-background-color: #087edb;
                                   -fx-text-fill: white;
                                   -fx-font-size: 20px;
                                   -fx-font-family: 'Segoe UI Emoji';
                                   -fx-background-radius: 8;
                                   -fx-cursor: hand;"/>
                </HBox>

                <HBox spacing="10">
                    <Label fx:id="strengthLabel"
                           text="Force: Non généré"
                           style="-fx-font-size: 13px;
                                  -fx-text-fill: #64748b;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lengthLabel"
                           text="Longueur: 0"
                           style="-fx-font-size: 13px;
                                  -fx-text-fill: #64748b;"/>
                </HBox>
            </VBox>

            <!-- Options de génération -->
            <VBox spacing="15"
                  style="-fx-background-color: #edf3f8;
                         -fx-border-color: #cbd5df;
                         -fx-border-radius: 10;
                         -fx-background-radius: 10;
                         -fx-padding: 20;">

                <Label text="Options de génération"
                       style="-fx-font-size: 16px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #1e293b;"/>

                <!-- Longueur -->
                <VBox spacing="8">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Longueur:"
                               style="-fx-font-size: 14px;
                                      -fx-text-fill: #52677d;"/>
                        <Label fx:id="lengthValueLabel"
                               text="16"
                               style="-fx-font-size: 14px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #087edb;"/>
                    </HBox>
                    <Slider fx:id="lengthSlider"
                            min="8"
                            max="64"
                            value="16"
                            showTickLabels="true"
                            showTickMarks="true"
                            majorTickUnit="8"
                            minorTickCount="7"
                            snapToTicks="true"
                            style="-fx-background-color: #e8edf2;"/>
                </VBox>

                <!-- Options de caractères -->
                <VBox spacing="12">
                    <CheckBox fx:id="uppercaseCheck"
                              text="Majuscules (A-Z)"
                              selected="true"
                              style="-fx-font-size: 14px;
                                     -fx-text-fill: #334155;"/>

                    <CheckBox fx:id="lowercaseCheck"
                              text="Minuscules (a-z)"
                              selected="true"
                              style="-fx-font-size: 14px;
                                     -fx-text-fill: #334155;"/>

                    <CheckBox fx:id="numbersCheck"
                              text="Chiffres (0-9)"
                              selected="true"
                              style="-fx-font-size: 14px;
                                     -fx-text-fill: #334155;"/>

                    <CheckBox fx:id="symbolsCheck"
                              text="Symboles (!@#$%^&amp;*)"
                              selected="true"
                              style="-fx-font-size: 14px;
                                     -fx-text-fill: #334155;"/>
                </VBox>
            </VBox>

        </VBox>
    </center>


    <!-- ==================== FOOTER ==================== -->

    <bottom>
        <HBox alignment="CENTER_LEFT"
              spacing="20"
              prefHeight="80"
              style="-fx-background-color: #f5f7f9;
                     -fx-border-color: #cbd5df;
                     -fx-border-width: 1 0 0 0;
                     -fx-padding: 10 20 10 20;">

            <!-- Statut -->
            <VBox spacing="4">
                <Label fx:id="statusLabel"
                       text="Prêt"
                       style="-fx-font-size: 15px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #334155;"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Bouton générer -->
            <Button fx:id="generateButton" text="Générer"
                    onAction="#generatePassword"
                    prefWidth="210"
                    prefHeight="50"
                    style="-fx-background-color: #22a06b;
                           -fx-text-fill: white;
                           -fx-font-size: 17px;
                           -fx-font-weight: bold;
                           -fx-background-radius: 9;
                           -fx-cursor: hand;"/>

        </HBox>
    </bottom>

</BorderPane>
