<?xml version="1.0" encoding="UTF-8"?>

<?import com.example.multitools.ui.BackButton?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.multitools.tools.security.NetworkAnalyzerController"
            stylesheets="@../style.css"
            styleClass="root">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12"
              style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 1 0; -fx-padding: 18 28;">
            <BackButton onAction="#handleBack"/>
            <Label text="📶" style="-fx-font-family: 'Segoe UI Emoji'; -fx-font-size: 24px;"/>
            <VBox spacing="2">
                <Label text="Analyseur réseau simplifié"
                       style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                <Label text="Observez les échanges réseau de cet appareil"
                       style="-fx-font-size: 13px; -fx-text-fill: #64748b;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
            <content>
                <HBox spacing="18" style="-fx-padding: 24;">
                    <VBox spacing="14" prefWidth="310" minWidth="260">
                        <VBox spacing="10"
                              style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #e2e8f0; -fx-border-radius: 12; -fx-padding: 20;">
                            <Label text="Comment l'utiliser"
                                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                            <Label text="1. Choisissez votre interface Wi-Fi. Seules les interfaces Wi-Fi sont proposées."
                                   wrapText="true"
                                   style="-fx-font-size: 14px; -fx-text-fill: #475569;"/>
                            <Label text="2. Cliquez sur Démarrer pour observer les paquets visibles sur cette interface de cet appareil."
                                   wrapText="true"
                                   style="-fx-font-size: 14px; -fx-text-fill: #475569;"/>
                            <Label text="3. Cliquez sur Arrêter quand vous avez terminé."
                                   wrapText="true"
                                   style="-fx-font-size: 14px; -fx-text-fill: #475569;"/>
                        </VBox>

                        <VBox spacing="8"
                              style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #e2e8f0; -fx-border-radius: 12; -fx-padding: 20;">
                            <Label text="Ce que vous voyez"
                                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                            <Label text="Chaque ligne est un paquet : TCP et UDP sont des types d'échanges. Source et destination indiquent les adresses et ports. La longueur est affichée en octets."
                                   wrapText="true"
                                   style="-fx-font-size: 13px; -fx-text-fill: #64748b;"/>
                        </VBox>

                        <VBox spacing="8"
                              style="-fx-background-color: #fff7ed; -fx-background-radius: 12; -fx-border-color: #fed7aa; -fx-border-radius: 12; -fx-padding: 20;">
                            <Label text="Confidentialité et prérequis"
                                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #9a3412;"/>
                            <Label text="La capture n'est pas en mode promiscuité : elle ne montre pas les échanges destinés uniquement à d'autres appareils du Wi-Fi. Le contenu des paquets n'est ni affiché ni enregistré dans un fichier. La liste reste temporaire et limitée aux 1 000 dernières lignes."
                                   wrapText="true"
                                   style="-fx-font-size: 13px; -fx-text-fill: #7c2d12;"/>
                            <Label text="La capture nécessite Npcap sur Windows (ou libpcap sur Linux/macOS). Selon le système, des droits supplémentaires peuvent être nécessaires. La détection Wi-Fi est basée sur les informations des cartes réseau du système."
                                   wrapText="true"
                                   style="-fx-font-size: 13px; -fx-text-fill: #7c2d12;"/>
                        </VBox>
                    </VBox>

                    <VBox spacing="12" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #e2e8f0; -fx-border-radius: 12; -fx-padding: 18;">
                        <Label text="Capture des paquets"
                               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <ComboBox fx:id="interfaceSelector"
                                      promptText="Choisir une interface"
                                      prefWidth="260"
                                      HBox.hgrow="ALWAYS"/>
                            <Button fx:id="refreshButton"
                                    text="Actualiser"
                                    onAction="#handleRefreshInterfaces"
                                    styleClass="secondary-button"/>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Button fx:id="startButton"
                                    text="Démarrer"
                                    onAction="#handleStartCapture"
                                    styleClass="primary-button"/>
                            <Button fx:id="stopButton"
                                    text="Arrêter"
                                    onAction="#handleStopCapture"
                                    styleClass="secondary-button"/>
                            <Button fx:id="clearButton"
                                    text="Vider la liste"
                                    onAction="#handleClearPackets"
                                    styleClass="secondary-button"/>
                        </HBox>
                        <Label fx:id="summaryLabel"
                               text="Recherche des interfaces réseau…"
                               wrapText="true"
                               style="-fx-font-size: 14px; -fx-text-fill: #475569;"/>
                        <TableView fx:id="packetTable" VBox.vgrow="ALWAYS" minHeight="360">
                            <columns>
                                <TableColumn fx:id="timeColumn" text="Heure" prefWidth="105"/>
                                <TableColumn fx:id="protocolColumn" text="Type" prefWidth="70"/>
                                <TableColumn fx:id="sourceColumn" text="Source" prefWidth="170"/>
                                <TableColumn fx:id="destinationColumn" text="Destination" prefWidth="170"/>
                                <TableColumn fx:id="lengthColumn" text="Longueur" prefWidth="90"/>
                            </columns>
                        </TableView>
                    </VBox>
                </HBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
