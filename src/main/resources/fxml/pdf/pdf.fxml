<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.multitools.tools.pdf.PdfController"
            stylesheets="@../style.css"
            styleClass="root">

    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="12"
              prefHeight="82"
              style="-fx-background-color: #f5f7f9;
                     -fx-border-color: #cbd5df;
                     -fx-border-width: 0 0 1 0;
                     -fx-padding: 0 20 0 20;">
            <Button text="← Retour"
                    onAction="#handleBack"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #64748b;
                           -fx-font-size: 14px;
                           -fx-cursor: hand;
                           -fx-padding: 8 12 8 12;"/>
            <Label text="📄"
                   style="-fx-font-family: 'Segoe UI Emoji';
                          -fx-font-size: 20px;"/>
            <VBox spacing="2">
                <Label text="PDF"
                       style="-fx-font-size: 20px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #111827;"/>
                <Label text="Outils pour vos documents PDF"
                       style="-fx-font-size: 14px;
                              -fx-text-fill: #64748b;"/>
            </VBox>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    fitToHeight="true"
                    style="-fx-background-color: #f8fafc;
                           -fx-border-color: transparent;">
            <VBox style="-fx-padding: 30 40 40 40;">
                <FlowPane hgap="20"
                          vgap="20"
                          alignment="TOP_CENTER">
                    <VBox spacing="12"
                          prefWidth="280"
                          prefHeight="180"
                          styleClass="tool-card"
                          style="-fx-padding: 24;"
                          onMouseClicked="#openMergeTool">
                        <HBox alignment="CENTER_LEFT" spacing="16">
                            <Label text="📑"
                                   style="-fx-font-family: 'Segoe UI Emoji';
                                          -fx-font-size: 32px;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                        </HBox>
                        <VBox spacing="4">
                            <Label text="Fusionner des PDF"
                                   style="-fx-font-size: 18px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #1e293b;
                                          -fx-font-family: 'Segoe UI', sans-serif;"/>
                            <Label text="Assembler plusieurs fichiers PDF"
                                   style="-fx-font-size: 13px;
                                          -fx-text-fill: #64748b;
                                          -fx-font-family: 'Segoe UI', sans-serif;"/>
                        </VBox>
                    </VBox>

                    <VBox spacing="12"
                          prefWidth="280"
                          prefHeight="180"
                          styleClass="tool-card"
                          style="-fx-padding: 24;"
                          onMouseClicked="#openProtectionTool">
                        <HBox alignment="CENTER_LEFT" spacing="16">
                            <Label text="🔐"
                                   style="-fx-font-family: 'Segoe UI Emoji';
                                          -fx-font-size: 32px;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                        </HBox>
                        <VBox spacing="4">
                            <Label text="Protéger un PDF"
                                   style="-fx-font-size: 18px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #1e293b;
                                          -fx-font-family: 'Segoe UI', sans-serif;"/>
                            <Label text="Ajouter un mot de passe à l'ouverture"
                                   style="-fx-font-size: 13px;
                                          -fx-text-fill: #64748b;
                                          -fx-font-family: 'Segoe UI', sans-serif;"/>
                        </VBox>
                    </VBox>

                    <VBox spacing="12"
                          prefWidth="280"
                          prefHeight="180"
                          styleClass="tool-card"
                          style="-fx-padding: 24;"
                          onMouseClicked="#openStampTool">
                        <HBox alignment="CENTER_LEFT" spacing="16">
                            <Label text="🖋"
                                   style="-fx-font-family: 'Segoe UI Emoji';
                                          -fx-font-size: 32px;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                        </HBox>
                        <VBox spacing="4">
                            <Label text="Ajouter un tampon"
                                   style="-fx-font-size: 18px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #1e293b;
                                          -fx-font-family: 'Segoe UI', sans-serif;"/>
                            <Label text="CONFIDENTIEL, BROUILLON, DUPLICATA ou texte personnalisé"
                                   style="-fx-font-size: 13px;
                                          -fx-text-fill: #64748b;
                                          -fx-font-family: 'Segoe UI', sans-serif;"/>
                        </VBox>
                    </VBox>
                </FlowPane>
            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
